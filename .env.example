# Copy to .env (git-ignored) and fill in. Loaded automatically by the backend.
# Google Gemini key from https://aistudio.google.com/apikey - enables the Disha copilot, DSDP narratives and NCO fallback.
GEMINI_API_KEY=
# Optional: model override (default gemini-3.8-flash)
# SKILLSIGHT_GEMINI_MODEL=gemini-3.8-flash
# Optional: refresh interval in hours (0 disables)
# SKILLSIGHT_REFRESH_HOURS=24
# Optional: enable Firebase sign-in
# FIREBASE_PROJECT_ID=
